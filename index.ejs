const express = require('express');
const path = require('path');
const app = express();

const getHomeView = require('./views/home');
const getFeaturesView = require('./views/features');
const getManageView = require('./views/manage');

app.use(express.json());
app.use(express.static(path.join(__dirname, 'public')));

app.get('/', (req, res) => {
    const fullHtml = `
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Drake Panel</title>
      <link rel="stylesheet" href="/style.css">
    </head>
    <body>
      <div class="phone-frame">
        <div class="top-bar">
          <h1 id="page-title">HOME</h1>
          <span style="font-size: 12px; color: var(--text-muted);">DRAKE PANEL</span>
        </div>

        <div class="content">
          ${getHomeView()}
          ${getFeaturesView()}
          ${getManageView()}
        </div>

        <div class="nav-bar" id="bottom-nav">
          <button class="nav-item active" onclick="switchTab('home', this)">HOME</button>
          <button class="nav-item" onclick="switchTab('features', this)">FEATURES</button>
          <button class="nav-item" onclick="switchTab('manage', this)">MANAGE</button>
        </div>
      </div>

      <script src="/script.js"></script>
    </body>
    </html>
    `;
    res.send(fullHtml);
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`Server running on port ${PORT}`));